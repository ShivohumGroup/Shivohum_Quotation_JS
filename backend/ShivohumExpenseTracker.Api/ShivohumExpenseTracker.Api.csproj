<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>shivohum-expense-tracker-api</UserSecretsId>
    <CompressionEnabled>false</CompressionEnabled>
    <BuildCompressionEnabled>false</BuildCompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
  </ItemGroup>

  <!-- Serve wwwroot locally; do not let the SDK pack it (hashes change every Angular build). -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="BuildAngular" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <FrontendDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\frontend'))</FrontendDir>
      <AngularOut>$(FrontendDir)\dist\frontend\browser</AngularOut>
    </PropertyGroup>
    <Message Importance="high" Text="Building Angular for Azure from $(FrontendDir)" />
    <Exec Command="npm install --silent" WorkingDirectory="$(FrontendDir)" />
    <Exec Command="npx ng build --configuration production" WorkingDirectory="$(FrontendDir)" />
    <ItemGroup>
      <DistFiles Include="$(AngularOut)\**\*.*" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
